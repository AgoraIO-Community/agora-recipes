    "voice-ai"
  ],
  "platforms": [
    "TypeScript"
  ],
  "useCases": [
    "Language Learning",
    "Voice AI"
  ],
  "capabilities": [
    "Conversational AI",
    "Voice Agent",
    "Agora RTC",
    "Next.js"
  ],
  "mainRepoUrl": "https://github.com/AgoraIO-Community/agora-speaking-coach-demo",
  "recipeUrl": "https://github.com/AgoraIO-Community/agora-speaking-coach-demo/blob/main/RECIPE.md",
  "demoUrl": "https://agora-speaking-coach-demo.vercel.app/",
  "author": "Agora",
  "updated": "2026-11-12",
  "difficulty": "Intermediate",
  "media": {
    "thumbnail": "https://raw.githubusercontent.com/AgoraIO-Community/agora-speaking-coach-demo/main/docs/recipe-cover.webp",
    "thumbnailAlt": "ASCII illustration for Mandarin Speaking Coach; supplied cover artwork, not a demo screenshot",
    "thumbnailSource": "https://github.com/AgoraIO-Community/agora-speaking-coach-demo/blob/main/docs/recipe-cover.webp"
  },
  "cli": {
    "projectType": "nextjs",
    "env": {
      "examplePath": "env.local.example",
      "targetPath": ".env.local",
      "appIdKey": "NEXT_PUBLIC_AGORA_APP_ID",
      "appCertificateKey": "NEXT_AGORA_APP_CERTIFICATE"
    },
    "installCommand": "pnpm install --frozen-lockfile",
    "runCommand": "pnpm run dev"
  },
  "setup": {
    "packageName": "agora-speaking-coach-demo",
    "packageVersion": "0.1.0",
    "npmAvailable": true,
    "directory": "my-speaking-app",
    "testRequest": "Help me practice ordering coffee in English and give me feedback."
  }
