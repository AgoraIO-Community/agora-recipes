      "appCertificateKey": "NEXT_AGORA_APP_CERTIFICATE"
    },
    "installCommand": "pnpm install --frozen-lockfile",
    "runCommand": "pnpm run dev"
  },
  "setup": {
    "packageName": "agora-speaking-coach-demo",
    "packageVersion": "0.1.3",
    "npmAvailable": true,
    "directory": "my-speaking-app",
    "testRequest": "Help me practice ordering coffee in Spanish and give me feedback in English."
  }
