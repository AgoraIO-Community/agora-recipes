    "voice-ai"
  ],
  "platforms": [
    "TypeScript"
  ],
  "useCases": [
    "Recruitment",
    "Voice AI"
  ],
  "capabilities": [
    "Conversational AI",
    "Voice Agent",
    "Agora RTC",
    "Next.js"
  ],
  "mainRepoUrl": "https://github.com/AgoraIO-Community/agora-recruitment-screening-assistant-demo",
  "recipeUrl": "https://github.com/AgoraIO-Community/agora-recruitment-screening-assistant-demo/blob/main/RECIPE.md",
  "demoUrl": "https://agora-recruitment-screening-assista.vercel.app/",
  "author": "Agora",
  "updated": "2026-11-12",
  "difficulty": "Intermediate",
  "media": {
    "thumbnail": "https://raw.githubusercontent.com/AgoraIO-Community/agora-recruitment-screening-assistant-demo/main/docs/recipe-cover.webp",
    "thumbnailAlt": "ASCII illustration for Recruitment Screening Assistant; supplied cover artwork, not a demo screenshot",
