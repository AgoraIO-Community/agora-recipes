  },
  "cli": {
    "projectType": "nextjs",
    "env": {
      "examplePath": "env.local.example",
      "targetPath": ".env.local",
      "appIdKey": "NEXT_PUBLIC_AGORA_APP_ID",
      "appCertificateKey": "NEXT_AGORA_APP_CERTIFICATE"
    },
    "installCommand": "pnpm install --frozen-lockfile",
    "runCommand": "pnpm run dev"
  },
  "setup": {
    "packageName": "agora-recruitment-screening-assistant-demo",
    "packageVersion": "0.1.0",
    "npmAvailable": true,
    "directory": "my-recruitment-app",
    "testRequest": "Start a practice screening interview and ask about my experience."
  }
